# Backend (WebSocket) event source.
#
# Copy to `.env.local` to run the frontend against FastAPI + PostgreSQL.
#
#   VITE_KAYAN_EVENT_SOURCE=backend
#   VITE_KAYAN_API_URL=http://127.0.0.1:8000
#
# Leave VITE_KAYAN_EVENT_SOURCE unset (or "mock") for the default local
# prototype, which needs no backend at all.
#
# Vite only exposes VITE_-prefixed variables, so the switch has that prefix.

VITE_KAYAN_EVENT_SOURCE=backend
VITE_KAYAN_API_URL=http://127.0.0.1:8000

# Optional: which backend stream to follow (defaults to "main").
# VITE_KAYAN_STREAM=main
