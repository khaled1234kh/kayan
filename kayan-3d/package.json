{
  "name": "kayan-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KAYAN 3D Office Foundation - visualization + interaction layer over a swappable domain transport",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check:transport": "esbuild scripts/transport-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-transport.mjs --log-level=error && node scripts/.out-transport.mjs",
    "check:mock": "esbuild scripts/mock-mode-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-mock.mjs --log-level=error && node scripts/.out-mock.mjs",
    "check:e2e": "esbuild scripts/e2e-bridge-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-e2e.mjs --log-level=error && node scripts/.out-e2e.mjs",
    "check:command": "esbuild scripts/e2e-command-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-command.mjs --log-level=error && node scripts/.out-command.mjs",
    "check:experiment": "esbuild scripts/e2e-experiment-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-experiment.mjs --log-level=error && node scripts/.out-experiment.mjs",
    "check:onboarding": "esbuild scripts/onboarding-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-onboarding.mjs --log-level=error && node scripts/.out-onboarding.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
