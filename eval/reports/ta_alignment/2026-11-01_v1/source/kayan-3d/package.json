{
  "name": "kayan-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KAYAN 3D Office Foundation - visualization + interaction layer over a swappable domain transport",
  "scripts": {
    "check:visual-feedback": "esbuild scripts/visual-feedback-check.tsx --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-visual-feedback.mjs --log-level=error && node scripts/.out-visual-feedback.mjs",
    "check:actor-picking": "esbuild scripts/actor-picking-check.ts --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-actor-picking.mjs --log-level=error && node scripts/.out-actor-picking.mjs",
    "check:performance-metrics": "esbuild scripts/performance-metrics-check.ts --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-performance-metrics.mjs --log-level=error && node scripts/.out-performance-metrics.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:trustgate": "esbuild scripts/trustgate-check.ts --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-trustgate.mjs --log-level=error && node scripts/.out-trustgate.mjs",
    "check:trustgate:live": "esbuild scripts/trustgate-live-check.ts --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-trustgate-live.mjs --log-level=error && node scripts/.out-trustgate-live.mjs",
    "check:session-panel": "esbuild scripts/session-panel-check.tsx --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-session-panel.mjs --log-level=error && node scripts/.out-session-panel.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check:transport": "esbuild scripts/transport-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-transport.mjs --log-level=error && node scripts/.out-transport.mjs",
    "check:mock": "esbuild scripts/mock-mode-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-mock.mjs --log-level=error && node scripts/.out-mock.mjs",
    "check:e2e": "esbuild scripts/e2e-bridge-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-e2e.mjs --log-level=error && node scripts/.out-e2e.mjs",
    "check:command": "esbuild scripts/e2e-command-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-command.mjs --log-level=error && node scripts/.out-command.mjs",
    "check:experiment": "esbuild scripts/e2e-experiment-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-experiment.mjs --log-level=error && node scripts/.out-experiment.mjs",
    "check:onboarding": "esbuild scripts/onboarding-check.ts --bundle --platform=node --format=esm --outfile=scripts/.out-onboarding.mjs --log-level=error && node scripts/.out-onboarding.mjs",
    "check:office": "esbuild scripts/office-geometry-check.tsx --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-office.mjs --log-level=error && node scripts/.out-office.mjs",
    "check:ta-alignment": "esbuild scripts/ta-alignment-check.tsx --bundle --packages=external --platform=node --format=esm --outfile=scripts/.out-ta-alignment.mjs --log-level=error && node scripts/.out-ta-alignment.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
