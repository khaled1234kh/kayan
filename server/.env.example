# Copy to .env and adjust. Never commit real credentials.

# --- Database -----------------------------------------------------------
# PostgreSQL is the authoritative store.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kayan

# Local dev convenience (Windows/macOS/Linux, no Docker needed):
#   python -m server.scripts.devdb --uri
# which prints a ready-to-use DATABASE_URL with JSONB support.

# --- Application --------------------------------------------------------
APP_NAME=KAYAN
APP_ENV=development
LOG_LEVEL=INFO

# Development-only event publisher (POST /api/dev/events, GET /api/dev/streams).
# Used to prove the WebSocket bridge end to end. Never mounted when
# APP_ENV=production, whatever this is set to.
ENABLE_DEV_ENDPOINTS=false

# Multiplier applied to each workflow step's authored delay when the runtime
# executes a commanded order. 0 (default) runs the workflow at full speed, because
# pacing is a presentation concern, not business logic. Try 0.05 to make the
# ~20s scripted order watchable in the browser.
RUNTIME_PACE_MS=0

# Backend experiments (baseline vs enforced). A research capability: opt-in, and
# never honoured when APP_ENV=production. Without this, the run_comparison
# command is refused with experiments_disabled.
ENABLE_EXPERIMENTS=false

# Rows returned by the read-only list endpoints.
API_DEFAULT_LIMIT=100
API_MAX_LIMIT=500